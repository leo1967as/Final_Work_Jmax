# ============================================================
# Modbus TCP Settings
# ============================================================
# ใช้ host.docker.internal เมื่อรัน Modbus Simulator บน Windows
MODBUS_HOST=host.docker.internal
MODBUS_PORT=502
MODBUS_UNIT_ID=1

# Register settings: อ่าน 5 Holding Registers
# สูตรแปลง: Address จริง = เลขที่เห็นใน Simulator - 400001
# ตัวอย่าง: Simulator แสดง 400211 → ใส่ 210
MODBUS_START_ADDRESS=210
MODBUS_REGISTER_COUNT=5

# Polling interval (milliseconds) — 20ms = ~50 reads/sec
POLL_INTERVAL_MS=20

# ============================================================
# InfluxDB v2 Settings
# ============================================================
INFLUXDB_URL=http://influxdb:8086
# Token will be auto-generated and saved to /var/lib/influxdb2/token.txt
INFLUXDB_TOKEN_FILE=/var/lib/influxdb2/token.txt
INFLUXDB_ORG=iot-org
INFLUXDB_BUCKET=plc_data

# InfluxDB initial setup (used by Docker container on first run)
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=adminpassword
DOCKER_INFLUXDB_INIT_ORG=iot-org
DOCKER_INFLUXDB_INIT_BUCKET=plc_data
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=my-super-secret-token

# ============================================================
# Batch Writer Settings
# ============================================================
# Flush to InfluxDB every N seconds OR when buffer reaches BATCH_SIZE
BATCH_FLUSH_INTERVAL_SEC=1
BATCH_SIZE=500

# ============================================================
# Grafana Settings
# ============================================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ============================================================
# Web UI Settings
# ============================================================
# Path สำหรับบันทึก CSV recordings (Docker volume mount)
RECORDINGS_DIR=/app/recordings

# Sensor labels (JSON array) - optional, defaults to Sensor 1..5
# SENSOR_LABELS=[{"id":"register_210","name":"Temperature","unit":"°C","icon":"thermostat"},...]
